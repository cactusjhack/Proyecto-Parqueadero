@page
@model ASP_Presentacion.Pages.Ventanas.SedesModel
@{
    ViewData["Title"] = "Sedes";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Sedes</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                @if (Model.Sede == null)
                {
                    <input type="submit" value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo" />
                }
                else
                {
                    <input type="submit" value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar" />
                }

                @if (Model.Sede == null && !Model.Borrando)
                {
                    <div class="mt-2">
                        <button type="button" onclick="window.print()"
                                class="btn btn-secondary">
                            🖨️ Imprimir
                        </button>

                        <a href="https://localhost:7160/Sedes/ExportarExcel"
                           class="btn btn-success">
                            📊 Exportar Excel
                        </a>

                        <a href="https://localhost:7160/Sedes/ExportarPDF"
                           class="btn btn-danger">
                            📄 Exportar PDF
                        </a>

                        <button type="button" onclick="verMapa()"
                                class="btn btn-info">
                            🗺️ Ver Mapa
                        </button>
                    </div>
                }
            </div>

            @if (Model.Sede != null)
            {
                <input type="hidden" asp-for="@Model.Sede!.Id" />
                <div>
                    <div class="form-group">
                        <label>Nombre</label>
                        <input class="form-control" asp-for="@Model.Sede!.Nombre" />
                    </div>
                    <div class="form-group">
                        <label>Dirección</label>
                        <input class="form-control" asp-for="@Model.Sede!.Direccion" />
                    </div>
                    <div class="form-group">
                        <label>Ciudad</label>
                        <input class="form-control" asp-for="@Model.Sede!.Ciudad" />
                    </div>
                    <div class="form-group">
                        <label>Teléfono</label>
                        <input class="form-control" asp-for="@Model.Sede!.Telefono" />
                    </div>
                    <div class="form-group">
                        <label>Activa</label>
                        <input asp-for="@Model.Sede!.Activa" />
                    </div>
                </div>
            }

            @if (Model.Sede != null && Model.Borrando)
            {
                <div class="popup">
                    <div>
                        <h2>Mensaje</h2>
                        <h6>¿Desea borrar la sede @Model.Sede!.Nombre?</h6>
                        <input type="submit" value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit" value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-secondary" />
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>Nombre</th>
                        <th>Dirección</th>
                        <th>Ciudad</th>
                        <th>Teléfono</th>
                        <th>Activa</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Nombre</td>
                            <td>@elemento.Direccion</td>
                            <td>@elemento.Ciudad</td>
                            <td>@elemento.Telefono</td>
                            <td>@elemento.Activa</td>
                            <td>
                                <input type="submit" value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
        <div id="mapa" style="height:400px; margin-top:20px; display:none; border-radius:10px;"></div>

        <link rel="stylesheet" href="https://unpkg.com/leaflet/dist/leaflet.css" />
        <script src="https://unpkg.com/leaflet/dist/leaflet.js"></script>

        <script>
            var mapaAbierto = false;
            var mapa = null;

            function verMapa() {
                var div = document.getElementById('mapa');
                if (!mapaAbierto) {
                    div.style.display = 'block';
                    if (!mapa) {
                        mapa = L.map('mapa').setView([6.2442, -75.5812], 13); // Medellín
                        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png').addTo(mapa);

                        // Marcadores de las sedes
                        var sedes = [
                            { nombre: "El Tesoro", lat: 6.1995, lng: -75.5756 },
                            { nombre: "Santafe", lat: 6.2671, lng: -75.5664 },
                            { nombre: "El Poblado", lat: 6.2087, lng: -75.5671 },
                            { nombre: "Viva Envigado", lat: 6.1683, lng: -75.5833 },
                            { nombre: "Premium Plaza", lat: 6.2344, lng: -75.5744 }
                        ];

                        sedes.forEach(function(sede) {
                            L.marker([sede.lat, sede.lng])
                             .addTo(mapa)
                             .bindPopup("<b>" + sede.nombre + "</b>");
                        });
                    }
                    mapaAbierto = true;
                } else {
                    div.style.display = 'none';
                    mapaAbierto = false;
                }
            }
        </script>
    </div>
</center>