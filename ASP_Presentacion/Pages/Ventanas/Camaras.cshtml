@page
@model ASP_Presentacion.Pages.Ventanas.CamarasModel
@{
    ViewData["Title"] = "Cámaras";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Cámaras</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                @if (Model.Camara == null)
                {
                    <input type="submit" value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo" />
                }
                else
                {
                    <input type="submit" value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar" />
                }
            </div>

            @if (Model.Camara != null)
            {
                <input type="hidden" asp-for="@Model.Camara!.Id" />
                <div>
                    <div class="form-group">
                        <label>Codigo</label>
                        <input class="form-control" asp-for="@Model.Camara!.Codigo" />
                    </div>
                    <div class="form-group">
                        <label>Ubicacion</label>
                        <input class="form-control" asp-for="@Model.Camara!.Ubicacion" />
                    </div>
                    <div class="form-group">
                        <label>Activa</label>
                        <input asp-for="@Model.Camara!.Activa" />
                    </div>
                    <div class="form-group">
                        <label>Piso</label>
                        <input class="form-control" asp-for="@Model.Camara!.Piso" />
                    </div>
                </div>
            }

            @if (Model.Camara != null && Model.Borrando)
            {
                <div class="popup">
                    <div>
                        <h2>Mensaje</h2>
                        <h6>¿Desea borrar la cámara @Model.Camara!.Codigo?</h6>
                        <input type="submit" value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit" value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-secondary" />
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>Codigo</th>
                        <th>Ubicacion</th>
                        <th>Activa</th>
                        <th>Piso</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Codigo</td>
                            <td>@elemento.Ubicacion</td>
                            <td>@elemento.Activa</td>
                            <td>@elemento.Piso</td>
                            <td>
                                <input type="submit" value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>