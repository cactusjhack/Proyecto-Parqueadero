@page
@model ASP_Presentacion.Pages.Ventanas.UsuariosModel
@{
    ViewData["Title"] = "Usuarios";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Usuarios</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                @if (Model.Usuario == null)
                {
                    <input type="submit" value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo" />
                }
                else
                {
                    <input type="submit" value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar" />
                }
            </div>

            @if (Model.Usuario != null)
            {
                <input type="hidden" asp-for="@Model.Usuario!.Id" />
                <div>
                    <div class="form-group">
                        <label>NombreUsuario</label>
                        <input class="form-control" asp-for="@Model.Usuario!.NombreUsuario" />
                    </div>
                    <div class="form-group">
                        <label>Contraseña</label>
                        <input class="form-control" asp-for="@Model.Usuario!.Contrasena" />
                    </div>
                    <div class="form-group">
                        <label>Activo</label>
                        <input asp-for="@Model.Usuario!.Activo" />
                    </div>
                    <div class="form-group">
                        <label>Rol</label>
                        <input class="form-control" asp-for="@Model.Usuario!.Rol" />
                    </div>
                    <div class="form-group">
                        <label>Empleado</label>
                        <input class="form-control" asp-for="@Model.Usuario!.Empleado" />
                    </div>
                </div>
            }

            @if (Model.Usuario != null && Model.Borrando)
            {
                <div class="popup">
                    <div>
                        <h2>Mensaje</h2>
                        <h6>¿Desea borrar el usuario @Model.Usuario!.NombreUsuario?</h6>
                        <input type="submit" value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit" value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-secondary" />
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>NombreUsuario</th>
                        <th>Contraseña</th>
                        <th>Activo</th>
                        <th>Rol</th>
                        <th>Empleado</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.NombreUsuario</td>
                            <td>@elemento.Contrasena</td>
                            <td>@elemento.Activo</td>
                            <td>@elemento.Rol</td>
                            <td>@elemento.Empleado</td>
                            <td>
                                <input type="submit" value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>