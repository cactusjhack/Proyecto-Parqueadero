@page
@model ASP_Presentacion.Pages.Ventanas.ConveniosModel
@{
    ViewData["Title"] = "Convenios";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Convenios</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                @if (Model.Convenio == null)
                {
                    <input type="submit" value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo" />
                }
                else
                {
                    <input type="submit" value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar" />
                }

                @if (Model.Convenio == null && !Model.Borrando)
                {
                    <div class="mt-2">
                        <button type="button" onclick="window.print()"
                                class="btn btn-secondary">
                            🖨️ Imprimir
                        </button>

                        <a href="https://localhost:7160/Convenios/ExportarExcel"
                           class="btn btn-success">
                            📊 Exportar Excel
                        </a>

                        <a href="https://localhost:7160/Convenios/ExportarPDF"
                           class="btn btn-danger">
                            📄 Exportar PDF
                        </a>
                    </div>
                }
            </div>

            @if (Model.Convenio != null)
            {
                <input type="hidden" asp-for="@Model.Convenio!.Id" />
                <div>
                    <div class="form-group">
                        <label>Empresa</label>
                        <input class="form-control" asp-for="@Model.Convenio!.Empresa" />
                    </div>
                    <div class="form-group">
                        <label>Descuento</label>
                        <input class="form-control" asp-for="@Model.Convenio!.Descuento" />
                    </div>
                    <div class="form-group">
                        <label>FechaInicio</label>
                        <input class="form-control" asp-for="@Model.Convenio!.FechaInicio" />
                    </div>
                    <div class="form-group">
                        <label>FechaFin</label>
                        <input class="form-control" asp-for="@Model.Convenio!.FechaFin" />
                    </div>
                    <div class="form-group">
                        <label>Activo</label>
                        <input asp-for="@Model.Convenio!.Activo" />
                    </div>
                    <div class="form-group">
                        <label>Sede</label>
                        <input class="form-control" asp-for="@Model.Convenio!.Sede" />
                    </div>
                </div>
            }

            @if (Model.Convenio != null && Model.Borrando)
            {
                <div class="popup">
                    <div>
                        <h2>Mensaje</h2>
                        <h6>¿Desea borrar el convenio @Model.Convenio!.Empresa?</h6>
                        <input type="submit" value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit" value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-secondary" />
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>Empresa</th>
                        <th>Descuento</th>
                        <th>FechaInicio</th>
                        <th>FechaFin</th>
                        <th>Activo</th>
                        <th>Sede</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Empresa</td>
                            <td>@elemento.Descuento</td>
                            <td>@elemento.FechaInicio</td>
                            <td>@elemento.FechaFin</td>
                            <td>@elemento.Activo</td>
                            <td>@elemento.Sede</td>
                            <td>
                                <input type="submit" value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>