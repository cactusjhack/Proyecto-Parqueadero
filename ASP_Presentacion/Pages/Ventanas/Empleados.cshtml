@page
@model ASP_Presentacion.Pages.Ventanas.EmpleadosModel
@{
    ViewData["Title"] = "Empleados";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Empleados</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                @if (Model.Empleado == null)
                {
                    <input type="submit" value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo" />
                }
                else
                {
                    <input type="submit" value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar" />
                }
            </div>

            @if (Model.Empleado != null)
            {
                <input type="hidden" asp-for="@Model.Empleado!.Id" />
                <div>
                    <div class="form-group">
                        <label>Nombre</label>
                        <input class="form-control" asp-for="@Model.Empleado!.Nombre" />
                    </div>
                    <div class="form-group">
                        <label>Apellido</label>
                        <input class="form-control" asp-for="@Model.Empleado!.Apellido" />
                    </div>
                    <div class="form-group">
                        <label>Cedula</label>
                        <input class="form-control" asp-for="@Model.Empleado!.Cedula" />
                    </div>
                    <div class="form-group">
                        <label>Telefono</label>
                        <input class="form-control" asp-for="@Model.Empleado!.Telefono" />
                    </div>
                    <div class="form-group">
                        <label>Correo</label>
                        <input class="form-control" asp-for="@Model.Empleado!.Correo" />
                    </div>
                    <div class="form-group">
                        <label>Cargo</label>
                        <input class="form-control" asp-for="@Model.Empleado!.Cargo" />
                    </div>
                    <div class="form-group">
                        <label>Turno</label>
                        <input class="form-control" asp-for="@Model.Empleado!.Turno" />
                    </div>
                </div>
            }

            @if (Model.Empleado != null && Model.Borrando)
            {
                <div class="popup">
                    <div>
                        <h2>Mensaje</h2>
                        <h6>¿Desea borrar el empleado @Model.Empleado!.Nombre?</h6>
                        <input type="submit" value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit" value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-secondary" />
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Cedula</th>
                        <th>Telefono</th>
                        <th>Correo</th>
                        <th>Cargo</th>
                        <th>Turno</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Nombre</td>
                            <td>@elemento.Apellido</td>
                            <td>@elemento.Cedula</td>
                            <td>@elemento.Telefono</td>
                            <td>@elemento.Correo</td>
                            <td>@elemento.Cargo</td>
                            <td>@elemento.Turno</td>
                            <td>
                                <input type="submit" value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>