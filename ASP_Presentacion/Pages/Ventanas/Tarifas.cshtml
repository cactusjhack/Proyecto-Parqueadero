@page
@model ASP_Presentacion.Pages.Ventanas.TarifasModel
@{
    ViewData["Title"] = "Tarifas";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Tarifas</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                @if (Model.Tarifa == null)
                {
                    <input type="submit" value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo" />
                }
                else
                {
                    <input type="submit" value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar" />
                }
            </div>

            @if (Model.Tarifa != null)
            {
                <input type="hidden" asp-for="@Model.Tarifa!.Id" />
                <div>
                    <div class="form-group">
                        <label>TipoVehiculo</label>
                        <input class="form-control" asp-for="@Model.Tarifa!.TipoVehiculo" />
                    </div>
                    <div class="form-group">
                        <label>PrecioHora</label>
                        <input class="form-control" asp-for="@Model.Tarifa!.PrecioHora" />
                    </div>
                    <div class="form-group">
                        <label>FraccionHora</label>
                        <input class="form-control" asp-for="@Model.Tarifa!.FraccionHora" />
                    </div>
                    <div class="form-group">
                        <label>AplicaCargador</label>
                        <input class="form-control" asp-for="@Model.Tarifa!.AplicaCargador" />
                    </div>
                    <div class="form-group">
                        <label>ValorCarga</label>
                        <input class="form-control" asp-for="@Model.Tarifa!.ValorCarga" />
                    </div>
                </div>
            }

            @if (Model.Tarifa != null && Model.Borrando)
            {
                <div class="popup">
                    <div>
                        <h2>Mensaje</h2>
                        <h6>¿Desea borrar la tarifa @Model.Tarifa!.TipoVehiculo?</h6>
                        <input type="submit" value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit" value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-secondary" />
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>TipoVehiculo</th>
                        <th>PrecioHora</th>
                        <th>FraccionHora</th>
                        <th>AplicaCargador</th>
                        <th>ValorCarga</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.TipoVehiculo</td>
                            <td>@elemento.PrecioHora</td>
                            <td>@elemento.FraccionHora</td>
                            <td>@elemento.AplicaCargador</td>
                            <td>@elemento.ValorCarga</td>
                            <td>
                                <input type="submit" value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>