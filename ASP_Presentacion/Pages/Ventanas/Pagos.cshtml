@page
@model ASP_Presentacion.Pages.Ventanas.PagosModel
@{
    ViewData["Title"] = "Pagos";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Pagos</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                @if (Model.Pago == null)
                {
                    <input type="submit" value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo" />
                }
                else
                {
                    <input type="submit" value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar" />
                }
            </div>

            @if (Model.Pago != null)
            {
                <input type="hidden" asp-for="@Model.Pago!.Id" />
                <div>
                    <div class="form-group">
                        <label>Cobro</label>
                        <input class="form-control" asp-for="@Model.Pago!.Cobro" />
                    </div>
                    <div class="form-group">
                        <label>MetodoPago</label>
                        <input class="form-control" asp-for="@Model.Pago!.MetodoPago" />
                    </div>
                    <div class="form-group">
                        <label>Valor</label>
                        <input class="form-control" asp-for="@Model.Pago!.Valor" />
                    </div>
                    <div class="form-group">
                        <label>Fecha</label>
                        <input class="form-control" asp-for="@Model.Pago!.Fecha" />
                    </div>
                    <div class="form-group">
                        <label>Aprobado</label>
                        <input asp-for="@Model.Pago!.Aprobado" />
                    </div>
                </div>
            }

            @if (Model.Pago != null && Model.Borrando)
            {
                <div class="popup">
                    <div>
                        <h2>Mensaje</h2>
                        <h6>¿Desea borrar el pago @Model.Pago!.Id?</h6>
                        <input type="submit" value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit" value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-secondary" />
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>Cobro</th>
                        <th>MetodoPago</th>
                        <th>Valor</th>
                        <th>Fecha</th>
                        <th>Aprobado</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Cobro</td>
                            <td>@elemento.MetodoPago</td>
                            <td>@elemento.Valor</td>
                            <td>@elemento.Fecha</td>
                            <td>@elemento.Aprobado</td>
                            <td>
                                <input type="submit" value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>