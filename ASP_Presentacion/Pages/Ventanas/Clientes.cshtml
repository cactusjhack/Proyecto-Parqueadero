@page
@model ASP_Presentacion.Pages.Ventanas.ClientesModel
@{
    ViewData["Title"] = "Clientes";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Clientes</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                @if (Model.Cliente == null)
                {
                    <input type="submit" value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo" />
                }
                else
                {
                    <input type="submit" value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar" />
                }

                @if (Model.Cliente == null && !Model.Borrando)
                {
                    <div class="mt-2">
                        <button type="button" onclick="window.print()"
                                class="btn btn-secondary">
                            🖨️ Imprimir
                        </button>

                        <a href="https://localhost:7160/Clientes/ExportarExcel"
                           class="btn btn-success">
                            📊 Exportar Excel
                        </a>

                        <a href="https://localhost:7160/Clientes/ExportarPDF"
                           class="btn btn-danger">
                            📄 Exportar PDF
                        </a>
                    </div>
                }
            </div>

            @if (Model.Cliente != null)
            {
                <input type="hidden" asp-for="@Model.Cliente!.Id" />
                <div>
                    <div class="form-group">
                        <label>Nombre</label>
                        <input class="form-control" asp-for="@Model.Cliente!.Nombre" />
                    </div>
                    <div class="form-group">
                        <label>Apellido</label>
                        <input class="form-control" asp-for="@Model.Cliente!.Apellido" />
                    </div>
                    <div class="form-group">
                        <label>Cedula</label>
                        <input class="form-control" asp-for="@Model.Cliente!.Cedula" />
                    </div>
                    <div class="form-group">
                        <label>Telefono</label>
                        <input class="form-control" asp-for="@Model.Cliente!.Telefono" />
                    </div>
                    <div class="form-group">
                        <label>Correo</label>
                        <input class="form-control" asp-for="@Model.Cliente!.Correo" />
                    </div>
                    <div class="form-group">
                        <label>NumeroViajero</label>
                        <input class="form-control" asp-for="@Model.Cliente!.NumeroViajero" />
                    </div>
                    <div class="form-group">
                        <label>Nacionalidad</label>
                        <input class="form-control" asp-for="@Model.Cliente!.Nacionalidad" />
                    </div>
                    <div class="form-group">
                        <label>NumeroPasaporte</label>
                        <input class="form-control" asp-for="@Model.Cliente!.NumeroPasaporte" />
                    </div>
                </div>
            }

            @if (Model.Cliente != null && Model.Borrando)
            {
                <div class="popup">
                    <div>
                        <h2>Mensaje</h2>
                        <h6>¿Desea borrar el cliente @Model.Cliente!.Nombre?</h6>
                        <input type="submit" value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit" value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-secondary" />
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>Nombre</th>
                        <th>Apellido</th>
                        <th>Cedula</th>
                        <th>Telefono</th>
                        <th>Correo</th>
                        <th>NumeroViajero</th>
                        <th>Nacionalidad</th>
                        <th>NumeroPasaporte</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Nombre</td>
                            <td>@elemento.Apellido</td>
                            <td>@elemento.Cedula</td>
                            <td>@elemento.Telefono</td>
                            <td>@elemento.Correo</td>
                            <td>@elemento.NumeroViajero</td>
                            <td>@elemento.Nacionalidad</td>
                            <td>@elemento.NumeroPasaporte</td>
                            <td>
                                <input type="submit" value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>