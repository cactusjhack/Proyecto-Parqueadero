@page
@model ASP_Presentacion.Pages.Ventanas.CobrosModel
@{
    ViewData["Title"] = "Cobros";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Cobros</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                @if (Model.Cobro == null)
                {
                    <input type="submit" value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo" />
                }
                else
                {
                    <input type="submit" value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar" />
                }
            </div>

            @if (Model.Cobro != null)
            {
                <input type="hidden" asp-for="@Model.Cobro!.Id" />
                <div>
                    <div class="form-group">
                        <label>Subtotal</label>
                        <input class="form-control" asp-for="@Model.Cobro!.Subtotal" />
                    </div>
                    <div class="form-group">
                        <label>Descuento</label>
                        <input class="form-control" asp-for="@Model.Cobro!.Descuento" />
                    </div>
                    <div class="form-group">
                        <label>Total</label>
                        <input class="form-control" asp-for="@Model.Cobro!.Total" />
                    </div>
                    <div class="form-group">
                        <label>Ingreso</label>
                        <input class="form-control" asp-for="@Model.Cobro!.Ingreso" />
                    </div>
                    <div class="form-group">
                        <label>UsoValet</label>
                        <input asp-for="@Model.Cobro!.UsoValet" />
                    </div>
                    <div class="form-group">
                        <label>TarifaValet</label>
                        <input class="form-control" asp-for="@Model.Cobro!.TarifaValet" />
                    </div>
                    <div class="form-group">
                        <label>Cliente</label>
                        <input class="form-control" asp-for="@Model.Cobro!.Cliente" />
                    </div>
                    <div class="form-group">
                        <label>Tarifa</label>
                        <input class="form-control" asp-for="@Model.Cobro!.Tarifa" />
                    </div>
                    <div class="form-group">
                        <label>Promocion</label>
                        <input class="form-control" asp-for="@Model.Cobro!.Promocion" />
                    </div>
                </div>
            }

            @if (Model.Cobro != null && Model.Borrando)
            {
                <div class="popup">
                    <div>
                        <h2>Mensaje</h2>
                        <h6>¿Desea borrar el cobro @Model.Cobro!.Id?</h6>
                        <input type="submit" value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit" value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-secondary" />
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>Subtotal</th>
                        <th>Descuento</th>
                        <th>Total</th>
                        <th>Ingreso</th>
                        <th>UsoValet</th>
                        <th>TarifaValet</th>
                        <th>Cliente</th>
                        <th>Tarifa</th>
                        <th>Promocion</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Subtotal</td>
                            <td>@elemento.Descuento</td>
                            <td>@elemento.Total</td>
                            <td>@elemento.Ingreso</td>
                            <td>@elemento.UsoValet</td>
                            <td>@elemento.TarifaValet</td>
                            <td>@elemento.Cliente</td>
                            <td>@elemento.Tarifa</td>
                            <td>@elemento.Promocion</td>
                            <td>
                                <input type="submit" value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>