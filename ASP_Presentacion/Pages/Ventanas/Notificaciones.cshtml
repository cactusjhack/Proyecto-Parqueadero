@page
@model ASP_Presentacion.Pages.Ventanas.NotificacionesModel
@{
    ViewData["Title"] = "Notificaciones";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Notificaciones</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                @if (Model.Notificacion == null)
                {
                    <input type="submit" value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo" />
                }
                else
                {
                    <input type="submit" value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar" />
                }
            </div>

            @if (Model.Notificacion != null)
            {
                <input type="hidden" asp-for="@Model.Notificacion!.Id" />
                <div>
                    <div class="form-group">
                        <label>Mensaje</label>
                        <input class="form-control" asp-for="@Model.Notificacion!.Mensaje" />
                    </div>
                    <div class="form-group">
                        <label>Leida</label>
                        <input asp-for="@Model.Notificacion!.Leida" />
                    </div>
                    <div class="form-group">
                        <label>Canal</label>
                        <input class="form-control" asp-for="@Model.Notificacion!.Canal" />
                    </div>
                    <div class="form-group">
                        <label>Fecha</label>
                        <input class="form-control" asp-for="@Model.Notificacion!.Fecha" />
                    </div>
                    <div class="form-group">
                        <label>Cliente</label>
                        <input class="form-control" asp-for="@Model.Notificacion!.Cliente" />
                    </div>
                </div>
            }

            @if (Model.Notificacion != null && Model.Borrando)
            {
                <div class="popup">
                    <div>
                        <h2>Mensaje</h2>
                        <h6>¿Desea borrar la notificación @Model.Notificacion!.Id?</h6>
                        <input type="submit" value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit" value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-secondary" />
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>Mensaje</th>
                        <th>Leida</th>
                        <th>Canal</th>
                        <th>Fecha</th>
                        <th>Cliente</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Mensaje</td>
                            <td>@elemento.Leida</td>
                            <td>@elemento.Canal</td>
                            <td>@elemento.Fecha</td>
                            <td>@elemento.Cliente</td>
                            <td>
                                <input type="submit" value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>