@page
@model ASP_Presentacion.Pages.Ventanas.PromocionesModel
@{
    ViewData["Title"] = "Promociones";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Promociones</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                @if (Model.Promocion == null)
                {
                    <input type="submit" value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo" />
                }
                else
                {
                    <input type="submit" value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar" />
                }
            </div>

            @if (Model.Promocion != null)
            {
                <input type="hidden" asp-for="@Model.Promocion!.Id" />
                <div>
                    <div class="form-group">
                        <label>Nombre</label>
                        <input class="form-control" asp-for="@Model.Promocion!.Nombre" />
                    </div>
                    <div class="form-group">
                        <label>Descuento</label>
                        <input class="form-control" asp-for="@Model.Promocion!.Descuento" />
                    </div>
                    <div class="form-group">
                        <label>FechaInicio</label>
                        <input class="form-control" asp-for="@Model.Promocion!.FechaInicio" />
                    </div>
                    <div class="form-group">
                        <label>FechaFin</label>
                        <input class="form-control" asp-for="@Model.Promocion!.FechaFin" />
                    </div>
                    <div class="form-group">
                        <label>Activa</label>
                        <input asp-for="@Model.Promocion!.Activa" />
                    </div>
                    <div class="form-group">
                        <label>TipoVehiculo</label>
                        <input class="form-control" asp-for="@Model.Promocion!.TipoVehiculo" />
                    </div>
                    <div class="form-group">
                        <label>SoloFinDeSemana</label>
                        <input class="form-control" asp-for="@Model.Promocion!.SoloFinDeSemana" />
                    </div>
                </div>
            }

            @if (Model.Promocion != null && Model.Borrando)
            {
                <div class="popup">
                    <div>
                        <h2>Mensaje</h2>
                        <h6>¿Desea borrar el convenio @Model.Promocion!.Nombre?</h6>
                        <input type="submit" value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit" value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-secondary" />
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>Nombre</th>
                        <th>Descuento</th>
                        <th>FechaInicio</th>
                        <th>FechaFin</th>
                        <th>Activa</th>
                        <th>TipoVehiculo</th>
                        <th>SoloFinDeSemana</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Nombre</td>
                            <td>@elemento.Descuento</td>
                            <td>@elemento.FechaInicio</td>
                            <td>@elemento.FechaFin</td>
                            <td>@elemento.Activa</td>
                            <td>@elemento.TipoVehiculo</td>
                            <td>@elemento.SoloFinDeSemana</td>
                            <td>
                                <input type="submit" value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>