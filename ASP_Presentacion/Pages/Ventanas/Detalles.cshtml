@page
@model ASP_Presentacion.Pages.Ventanas.DetallesModel
@{
    ViewData["Title"] = "Detalles";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Detalles</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                @if (Model.Detalle == null)
                {
                    <input type="submit" value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo" />
                }
                else
                {
                    <input type="submit" value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar" />
                }

                @if (Model.Detalle == null && !Model.Borrando)
                {
                    <div class="mt-2">
                        <button type="button" onclick="window.print()"
                                class="btn btn-secondary">
                            🖨️ Imprimir
                        </button>

                        <a href="https://localhost:7160/Detalles/ExportarExcel"
                           class="btn btn-success">
                            📊 Exportar Excel
                        </a>

                        <a href="https://localhost:7160/Detalles/ExportarPDF"
                           class="btn btn-danger">
                            📄 Exportar PDF
                        </a>
                    </div>
                }
            </div>

            @if (Model.Detalle != null)
            {
                <input type="hidden" asp-for="@Model.Detalle!.Id" />
                <div>
                    <div class="form-group">
                        <label>Ingreso</label>
                        <input asp-for="@Model.Detalle!.Ingreso" />
                    </div>
                    <div class="form-group">
                        <label>Descripcion</label>
                        <input class="form-control" asp-for="@Model.Detalle!.Descripcion" />
                    </div>
                    <div class="form-group">
                        <label>Fecha</label>
                        <input class="form-control" asp-for="@Model.Detalle!.Fecha" />
                    </div>
                    <div class="form-group">
                        <label>Vehiculo</label>
                        <input class="form-control" asp-for="@Model.Detalle!.Vehiculo" />
                    </div>
                    <div class="form-group">
                        <label>Empleado</label>
                        <input class="form-control" asp-for="@Model.Detalle!.Empleado" />
                    </div>
                </div>
            }

            @if (Model.Detalle != null && Model.Borrando)
            {
                <div class="popup">
                    <div>
                        <h2>Mensaje</h2>
                        <h6>¿Desea borrar el detalle @Model.Detalle!.Id?</h6>
                        <input type="submit" value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit" value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-secondary" />
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>Ingreso</th>
                        <th>Descripcion</th>
                        <th>Fecha</th>
                        <th>Vehiculo</th>
                        <th>Empleado</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Ingreso</td>
                            <td>@elemento.Descripcion</td>
                            <td>@elemento.Fecha</td>
                            <td>@elemento.Vehiculo</td>
                            <td>@elemento.Empleado</td>
                            <td>
                                <input type="submit" value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>