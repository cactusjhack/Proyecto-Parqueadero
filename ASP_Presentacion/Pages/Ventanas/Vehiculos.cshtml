@page
@model ASP_Presentacion.Pages.Ventanas.VehiculosModel
@{
    ViewData["Title"] = "Vehículos";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Vehículos</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                @if (Model.Vehiculo == null)
                {
                    <input type="submit" value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo" />
                }
                else
                {
                    <input type="submit" value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar" />
                }
            </div>

            @if (Model.Vehiculo != null)
            {
                <input type="hidden" asp-for="@Model.Vehiculo!.Id" />
                <div>
                    <div class="form-group">
                        <label>Tipo</label>
                        <input class="form-control" asp-for="@Model.Vehiculo!.Tipo" />
                    </div>
                    <div class="form-group">
                        <label>Placa</label>
                        <input class="form-control" asp-for="@Model.Vehiculo!.Placa" />
                    </div>
                    <div class="form-group">
                        <label>Marca</label>
                        <input class="form-control" asp-for="@Model.Vehiculo!.Marca" />
                    </div>
                    <div class="form-group">
                        <label>Color</label>
                        <input class="form-control" asp-for="@Model.Vehiculo!.Color" />
                    </div>
                    <div class="form-group">
                        <label>Combustion</label>
                        <input class="form-control" asp-for="@Model.Vehiculo!.Combustion" />
                    </div>
                    <div class="form-group">
                        <label>Cliente</label>
                        <input class="form-control" asp-for="@Model.Vehiculo!.Cliente" />
                    </div>
                </div>
            }

            @if (Model.Vehiculo != null && Model.Borrando)
            {
                <div class="popup">
                    <div>
                        <h2>Mensaje</h2>
                        <h6>¿Desea borrar el vehículo @Model.Vehiculo!.Marca?</h6>
                        <input type="submit" value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit" value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-secondary" />
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>Tipo</th>
                        <th>Placa</th>
                        <th>Marca</th>
                        <th>Color</th>
                        <th>Combustion</th>
                        <th>Cliente</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Tipo</td>
                            <td>@elemento.Placa</td>
                            <td>@elemento.Marca</td>
                            <td>@elemento.Color</td>
                            <td>@elemento.Combustion</td>
                            <td>@elemento.Cliente</td>
                            <td>
                                <input type="submit" value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>