@page
@model ASP_Presentacion.Pages.Ventanas.IngresosModel
@{
    ViewData["Title"] = "Ingresos";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Ingresos</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                @if (Model.Ingreso == null)
                {
                    <input type="submit" value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo" />
                }
                else
                {
                    <input type="submit" value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar" />
                }

                @if (Model.Ingreso == null && !Model.Borrando)
                {
                    <div class="mt-2">
                        <button type="button" onclick="window.print()"
                                class="btn btn-secondary">
                            🖨️ Imprimir
                        </button>

                        <a href="https://localhost:7160/Ingresos/ExportarExcel"
                           class="btn btn-success">
                            📊 Exportar Excel
                        </a>

                        <a href="https://localhost:7160/Ingresos/ExportarPDF"
                           class="btn btn-danger">
                            📄 Exportar PDF
                        </a>
                    </div>
                }
            </div>

            @if (Model.Ingreso != null)
            {
                <input type="hidden" asp-for="@Model.Ingreso!.Id" />
                <div>
                    <div class="form-group">
                        <label>HoraEntrada</label>
                        <input class="form-control" asp-for="@Model.Ingreso!.HoraEntrada" />
                    </div>
                    <div class="form-group">
                        <label>HoraSalida</label>
                        <input class="form-control" asp-for="@Model.Ingreso!.HoraSalida" />
                    </div>
                    <div class="form-group">
                        <label>TotalHoras</label>
                        <input class="form-control" asp-for="@Model.Ingreso!.TotalHoras" />
                    </div>
                    <div class="form-group">
                        <label>Vehiculo</label>
                        <input class="form-control" asp-for="@Model.Ingreso!.Vehiculo" />
                    </div>
                    <div class="form-group">
                        <label>Empleado</label>
                        <input class="form-control" asp-for="@Model.Ingreso!.Empleado" />
                    </div>
                    <div class="form-group">
                        <label>Espacio</label>
                        <input class="form-control" asp-for="@Model.Ingreso!.Espacio" />
                    </div>
                </div>
            }

            @if (Model.Ingreso != null && Model.Borrando)
            {
                <div class="popup">
                    <div>
                        <h2>Mensaje</h2>
                        <h6>¿Desea borrar el ingreso @Model.Ingreso!.Id?</h6>
                        <input type="submit" value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit" value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-secondary" />
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>HoraEntrada</th>
                        <th>HoraSalida</th>
                        <th>TotalHoras</th>
                        <th>Vehiculo</th>
                        <th>Empleado</th>
                        <th>Espacio</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.HoraEntrada</td>
                            <td>@elemento.HoraSalida</td>
                            <td>@elemento.TotalHoras</td>
                            <td>@elemento.Vehiculo</td>
                            <td>@elemento.Empleado</td>
                            <td>@elemento.Espacio</td>
                            <td>
                                <input type="submit" value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>