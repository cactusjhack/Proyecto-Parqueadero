@page
@model ASP_Presentacion.Pages.Ventanas.TiquetesModel
@{
    ViewData["Title"] = "Tiquetes";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Tiquetes</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                @if (Model.Tiquete == null)
                {
                    <input type="submit" value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo" />
                }
                else
                {
                    <input type="submit" value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar" />
                }
            </div>

            @if (Model.Tiquete != null)
            {
                <input type="hidden" asp-for="@Model.Tiquete!.Id" />
                <div>
                    <div class="form-group">
                        <label>Codigo</label>
                        <input class="form-control" asp-for="@Model.Tiquete!.Codigo" />
                    </div>
                    <div class="form-group">
                        <label>FechaGeneracion</label>
                        <input class="form-control" asp-for="@Model.Tiquete!.FechaGeneracion" />
                    </div>
                    <div class="form-group">
                        <label>Pagado</label>
                        <input asp-for="@Model.Tiquete!.Pagado" />
                    </div>
                    <div class="form-group">
                        <label>FechaVencimiento</label>
                        <input class="form-control" asp-for="@Model.Tiquete!.FechaVencimiento" />
                    </div>
                    <div class="form-group">
                        <label>Ingreso</label>
                        <input class="form-control" asp-for="@Model.Tiquete!.Ingreso" />
                    </div>
                </div>
            }

            @if (Model.Tiquete != null && Model.Borrando)
            {
                <div class="popup">
                    <div>
                        <h2>Mensaje</h2>
                        <h6>¿Desea borrar el tiquete @Model.Tiquete!.Codigo?</h6>
                        <input type="submit" value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit" value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-secondary" />
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>Codigo</th>
                        <th>FechaGeneracion</th>
                        <th>Pagado</th>
                        <th>FechaVencimiento</th>
                        <th>Ingreso</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Codigo</td>
                            <td>@elemento.FechaGeneracion</td>
                            <td>@elemento.Pagado</td>
                            <td>@elemento.FechaVencimiento</td>
                            <td>@elemento.Ingreso</td>
                            <td>
                                <input type="submit" value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>