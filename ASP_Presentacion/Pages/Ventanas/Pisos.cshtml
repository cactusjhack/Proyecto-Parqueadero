@page
@model ASP_Presentacion.Pages.Ventanas.PisosModel
@{
    ViewData["Title"] = "Pisos";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Pisos</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                @if (Model.Piso == null)
                {
                    <input type="submit" value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo" />
                }
                else
                {
                    <input type="submit" value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar" />
                }

                @if (Model.Piso == null && !Model.Borrando)
                {
                    <div class="mt-2">
                        <button type="button" onclick="window.print()"
                                class="btn btn-secondary">
                            🖨️ Imprimir
                        </button>

                        <a href="https://localhost:7160/Pisos/ExportarExcel"
                           class="btn btn-success">
                            📊 Exportar Excel
                        </a>

                        <a href="https://localhost:7160/Pisos/ExportarPDF"
                           class="btn btn-danger">
                            📄 Exportar PDF
                        </a>
                    </div>
                }
            </div>

            @if (Model.Piso != null)
            {
                <input type="hidden" asp-for="@Model.Piso!.Id" />
                <div>
                    <div class="form-group">
                        <label>Nombre</label>
                        <input class="form-control" asp-for="@Model.Piso!.Nombre" />
                    </div>
                    <div class="form-group">
                        <label>Capacidad</label>
                        <input class="form-control" asp-for="@Model.Piso!.Capacidad" />
                    </div>
                    <div class="form-group">
                        <label>Descripcion</label>
                        <input class="form-control" asp-for="@Model.Piso!.Descripcion" />
                    </div>
                    <div class="form-group">
                        <label>Activo</label>
                        <input asp-for="@Model.Piso!.Activo" />
                    </div>
                    <div class="form-group">
                        <label>Sede</label>
                        <input class="form-control" asp-for="@Model.Piso!.Sede" />
                    </div>
                </div>
            }

            @if (Model.Piso != null && Model.Borrando)
            {
                <div class="popup">
                    <div>
                        <h2>Mensaje</h2>
                        <h6>¿Desea borrar el piso @Model.Piso!.Nombre?</h6>
                        <input type="submit" value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit" value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-secondary" />
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>Nombre</th>
                        <th>Capacidad</th>
                        <th>Descripcion</th>
                        <th>Activo</th>
                        <th>Sede</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Nombre</td>
                            <td>@elemento.Capacidad</td>
                            <td>@elemento.Descripcion</td>
                            <td>@elemento.Activo</td>
                            <td>@elemento.Sede</td>
                            <td>
                                <input type="submit" value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>