@page
@model ASP_Presentacion.Pages.Ventanas.FichosModel
@{
    ViewData["Title"] = "Fichos";
}

<center>
    <div>
        <form method="POST" enctype="multipart/form-data">
            @Html.AntiForgeryToken()

            <div align="left">
                <h3>Fichos</h3>
            </div>

            <div>
                <input type="submit" value="Refrescar"
                       class="btn btn-secondary"
                       asp-page-handler="BtRefrescar" />
                @if (Model.Ficho == null)
                {
                    <input type="submit" value="Nuevo"
                           class="btn btn-secondary"
                           asp-page-handler="BtNuevo" />
                }
                else
                {
                    <input type="submit" value="Guardar"
                           class="btn btn-secondary"
                           asp-page-handler="BtGuardar" />
                }

                @if (Model.Ficho == null && !Model.Borrando)
                {
                    <div class="mt-2">
                        <button type="button" onclick="window.print()"
                                class="btn btn-secondary">
                            🖨️ Imprimir
                        </button>

                        <a href="https://localhost:7160/Fichos/ExportarExcel"
                           class="btn btn-success">
                            📊 Exportar Excel
                        </a>

                        <a href="https://localhost:7160/Fichos/ExportarPDF"
                           class="btn btn-danger">
                            📄 Exportar PDF
                        </a>
                    </div>
                }
            </div>

            @if (Model.Ficho != null)
            {
                <input type="hidden" asp-for="@Model.Ficho!.Id" />
                <div>
                    <div class="form-group">
                        <label>Fecha</label>
                        <input class="form-control" asp-for="@Model.Ficho!.Fecha" />
                    </div>
                    <div class="form-group">
                        <label>Codigo</label>
                        <input class="form-control" asp-for="@Model.Ficho!.Codigo" />
                    </div>
                    <div class="form-group">
                        <label>Entregado</label>
                        <input asp-for="@Model.Ficho!.Entregado" />
                    </div>
                    <div class="form-group">
                        <label>Cliente</label>
                        <input class="form-control" asp-for="@Model.Ficho!.Cliente" />
                    </div>
                </div>
            }

            @if (Model.Ficho != null && Model.Borrando)
            {
                <div class="popup">
                    <div>
                        <h2>Mensaje</h2>
                        <h6>¿Desea borrar el ficho @Model.Ficho!.Codigo?</h6>
                        <input type="submit" value="Cerrar"
                               asp-page-handler="BtCerrar"
                               class="btn btn-secondary" />
                        <input type="submit" value="Borrar"
                               asp-page-handler="BtBorrar"
                               class="btn btn-secondary" />
                    </div>
                </div>
            }

            @if (Model.Lista != null && Model.Lista.Count > 0)
            {
                <table class="table table-striped table-bordered table-hover">
                    <tr>
                        <th>Fecha</th>
                        <th>Codigo</th>
                        <th>Entregado</th>
                        <th>Cliente</th>
                    </tr>
                    @foreach (var elemento in Model.Lista)
                    {
                        <tr>
                            <td>@elemento.Fecha</td>
                            <td>@elemento.Codigo</td>
                            <td>@elemento.Entregado</td>
                            <td>@elemento.Cliente</td>
                            <td>
                                <input type="submit" value="Modificar"
                                       asp-page-handler="BtModificar"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                                <input type="submit" value="Borrar"
                                       asp-page-handler="BtBorrarVal"
                                       class="btn btn-secondary"
                                       asp-route-data="@elemento.Id" />
                            </td>
                        </tr>
                    }
                </table>
            }
        </form>
    </div>
</center>